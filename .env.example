# === Frontend / shared (корень репозитория: .env.local) ===
# Локально:
# NEXT_PUBLIC_DJANGO_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# На сервере (пример):
NEXT_PUBLIC_DJANGO_URL=https://tagirovweb.ru
NEXT_PUBLIC_SITE_URL=https://tagirovweb.ru
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/robertprog
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# === Django (тот же .env.local читает и backend) ===
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tagirovweb.ru,www.tagirovweb.ru,127.0.0.1,localhost
DJANGO_CORS_ORIGIN=https://tagirovweb.ru
DJANGO_SECURE_COOKIES=true

# Legacy cookie admin (bootstrap). Лучше staff-пользователь Django.
ADMIN_PASSWORD=change-me

# Telegram lead notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email via Resend
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=
